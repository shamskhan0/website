# Admin portal credentials (build-time environment variables).
# Copy this file to .env and fill in real values. Never commit .env.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=change-me
VITE_ADMIN_NAME=Administrator

# Cloud sync (images/settings sab users ko dikhane ke liye)
# Setup: POST {} to https://jsonblob.com/api/jsonBlob
# → Location header mein jo blob id aaye wo yahan daalein.
VITE_CLOUD_BLOB_ID=
